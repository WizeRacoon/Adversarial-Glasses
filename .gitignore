# Environment
__pycache__/
*.py[cod]
.env
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Block all generated media and data
*.jpg
*.jpeg
*.csv
*.pdf
*.png

# EXCEPTIONS: Allow the mask template, sample data, assets, and gitkeeps
!data/glasses_template.png
!data/sample/**
!assets/**
!**/.gitkeep

# Completely ignore folder contents (except gitkeeps)
data/private/*
!data/private/.gitkeep

outputs/*
!outputs/.gitkeep